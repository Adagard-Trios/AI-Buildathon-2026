# Copy to .env at the repository root. Read by docker-compose.yml.
#
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every backend service shares this one value: the platform service ISSUES tokens with it and
# each component VERIFIES them with it. That is what lets a component authenticate a request
# without calling the platform service on every hit — so a slow or restarted platform cannot
# take the others down with it.
#
# The platform service refuses to start if this is unset, shorter than 32 characters, or
# still the placeholder below. A default secret that silently works everywhere is the classic
# way this ends up forgeable by anyone who has read the repository.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the backends. The frontend calls each
# service directly, so every service must permit the frontend's origin or the browser
# discards the response before any handler runs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Component 4's agent runs on a LOCAL Ollama model (agent.py uses ChatOllama), so there is
# no API key to set. It needs Ollama running on the host with the model its code asks for;
# without that the service still starts and /health still answers, and only
# /assistant/chat fails -- which the Assistant screen reports rather than implying the whole
# component is missing.

# --- FirstStep additions -------------------------------------------------------------------
# Optional. Without a key everything falls back to rules / local Ollama and says so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Machine identities for service-to-service calls (platform /auth/token, client credentials).
# SERVICE_CLIENTS="id:secret:scope1 scope2;id2:secret2:scope"  e.g.
#   fraud:<long-random>:audit.write;portfolio:<long-random>:audit.write;bank:<long-random>:fraud.read campaigns.read
SERVICE_CLIENTS=
FRAUD_CLIENT_ID=
FRAUD_CLIENT_SECRET=
PORTFOLIO_CLIENT_ID=
PORTFOLIO_CLIENT_SECRET=
# Laya fast path: served only for languages listed here after eval.py validates them.
LAYA_ENDPOINT=
LAYA_LANGS_VALIDATED=
SHADOW_RATE=0.05
GUARDIAN_ENABLED=true
GUARDIAN_WEBHOOK=
# DEMO_MODE enables Tamper and shows step-up codes. MUST be false in production.
DEMO_MODE=false
# Opt-in live link checks for Scam Shield
RDAP_ENABLED=false
WEBRISK_API_KEY=
# Component 3 on Google Cloud
BQ_DATASET=
PUBSUB_AUDIENCE=
PUBSUB_PUSH_SA=
