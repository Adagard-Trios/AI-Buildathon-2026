# Copy to .env at the repository root. Read by docker-compose.yml.
#
# Tokens are RS256 under docker compose. The platform generates its signing key on first start
# into its own volume, and every component verifies with the public key it publishes at
# /.well-known/jwks.json. No component holds anything that can mint a token, so there is no
# shared secret to set here.
#
# JWT_SECRET is only for the legacy HS256 mode: running services by hand without a signing
# key (see INTEGRATION.md). The platform refuses a value shorter than 32 characters or equal
# to this placeholder.
# JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the backends. The frontend calls each
# service directly, so every service must permit the frontend's origin or the browser
# discards the response before any handler runs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Component 4's agent runs on a LOCAL Ollama model (agent.py uses ChatOllama), so there is
# no API key to set. It needs Ollama running on the host with the model its code asks for;
# without that the service still starts and /health still answers, and only
# /assistant/chat fails -- which the Assistant screen reports rather than implying the whole
# component is missing.

# --- FirstStep additions -------------------------------------------------------------------
# Optional. Without a key everything falls back to rules / local Ollama and says so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Machine identities for service-to-service calls (platform /auth/token, client credentials).
# REQUIRED by docker-compose: with AUTH_REQUIRED on, a component without an identity cannot
# anchor decisions or report denials to Component 3. Each secret must match its entry below.
# SERVICE_CLIENTS="id:secret:scope1 scope2;id2:secret2:scope". External systems get their own
# entry with only the scopes they need, e.g. bank:<long-random>:fraud.read
SERVICE_CLIENTS="fraud:<fraud-secret>:audit.write;portfolio:<portfolio-secret>:audit.write;assistant:<assistant-secret>:audit.write"
FRAUD_CLIENT_ID=fraud
FRAUD_CLIENT_SECRET=<fraud-secret>
PORTFOLIO_CLIENT_ID=portfolio
PORTFOLIO_CLIENT_SECRET=<portfolio-secret>
ASSISTANT_CLIENT_ID=assistant
ASSISTANT_CLIENT_SECRET=<assistant-secret>
# User roles, granted only here (never through the API). auditor: human review of flagged
# decisions; admin: reset audit records (DEMO_MODE only). "email:role1 role2;email2:role"
PLATFORM_ROLES=
# Laya fast path: served only for languages listed here after eval.py validates them.
LAYA_ENDPOINT=
LAYA_LANGS_VALIDATED=
SHADOW_RATE=0.05
GUARDIAN_ENABLED=true
GUARDIAN_WEBHOOK=
# DEMO_MODE enables Tamper and shows step-up codes. MUST be false in production.
DEMO_MODE=false
# Opt-in live link checks for Scam Shield
RDAP_ENABLED=false
WEBRISK_API_KEY=
# Component 3 on Google Cloud
BQ_DATASET=
PUBSUB_AUDIENCE=
PUBSUB_PUSH_SA=

# Host interface the stack listens on. 127.0.0.1 keeps it on this machine; set 0.0.0.0 only
# to test the mobile app from a phone on the same Wi-Fi.
BIND_ADDR=127.0.0.1
